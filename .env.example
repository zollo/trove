# ─────────────────────────────────────────────────────────────
# Trove environment configuration
# Copy to `.env` and fill in real values for local development.
# ─────────────────────────────────────────────────────────────

# --- Core ---
TROVE_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated origins allowed by CORS (the frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# The URL people use to reach Trove (shown on the Settings page for MCP/API setup)
TROVE_PUBLIC_URL=http://localhost:8080

# --- Database ---
POSTGRES_USER=trove
POSTGRES_PASSWORD=trove
POSTGRES_DB=trove
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full URL is derived from the parts above by config.py, override if needed:
# DATABASE_URL=postgresql+asyncpg://trove:trove@postgres:5432/trove

# --- Auth ---
# Session token lifetime for the web UI (API keys don't expire; revoke them instead)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256
# Let candidates create their own accounts from the login page
ALLOW_CANDIDATE_REGISTRATION=true

# --- Bootstrap headhunter (created on first startup if it does not exist) ---
BOOTSTRAP_HEADHUNTER_EMAIL=headhunter@example.com
BOOTSTRAP_HEADHUNTER_PASSWORD=change-me-please

# --- Google sign-in (optional; off unless both are set) ---
# OAuth "Web application" client from Google Cloud; see README "Google sign-in".
# Its authorized redirect URI must be TROVE_PUBLIC_URL + /auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if Trove is reached on a different URL than TROVE_PUBLIC_URL:
# GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# --- Uploads ---
MAX_UPLOAD_MB=10

# --- Frontend (baked at build time) ---
# Leave EMPTY for same-origin: the frontend nginx proxies /api and /mcp to the
# backend, so the SPA uses relative URLs and works behind any host. Only set this
# to an absolute URL when the API is served from a different origin.
VITE_API_BASE_URL=
