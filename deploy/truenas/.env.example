# ─────────────────────────────────────────────────────────────────────────
# Trove — TrueNAS environment. Copy to `.env` next to docker-compose.yml.
# Generate strong secrets:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────

# Where persistent Postgres data lives. MUST be a real dataset path on your
# pool — change 'tank' to your pool name. Create it first (see README).
TROVE_DATA=/mnt/tank/apps/trove

# Host port to expose the web UI (and /api, /mcp) on.
TROVE_PORT=30081

# The URL people (and AI tools) will use to reach Trove.
TROVE_PUBLIC_URL=http://truenas.local:30081

# Image tag to run (latest, X.Y.Z, X.Y, or sha-<short>).
TROVE_TAG=latest

# --- Secrets ---
# SECRET_KEY is required (the stack refuses to start without it).
SECRET_KEY=
# Set before the first start; defaults to "trove" (Postgres is internal-only).
POSTGRES_PASSWORD=
# Blank = a random password is generated and printed in the backend log once.
BOOTSTRAP_HEADHUNTER_PASSWORD=

# --- Optional overrides ---
POSTGRES_USER=trove
POSTGRES_DB=trove
BOOTSTRAP_HEADHUNTER_EMAIL=headhunter@example.com
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_CANDIDATE_REGISTRATION=true
MAX_UPLOAD_MB=10

# --- Google sign-in (optional; off unless both are set) ---
# Google only accepts https redirect URIs on a public domain, so this needs
# TROVE_PUBLIC_URL to be an https URL (e.g. behind a reverse proxy or tunnel).
# Authorized redirect URI in Google Cloud: TROVE_PUBLIC_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
