# ─────────────────────────────────────────────────────────────────────────
# Trove — TrueNAS environment. Copy to `.env` next to docker-compose.yml.
# Generate strong secrets:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────

# Where persistent Postgres data lives. MUST be a real dataset path on your
# pool — change 'tank' to your pool name. Create it first (see README).
TROVE_DATA=/mnt/tank/apps/trove

# Host port to expose the web UI (and /api, /mcp) on.
TROVE_PORT=30081

# The URL people (and AI tools) will use to reach Trove.
TROVE_PUBLIC_URL=http://truenas.local:30081

# Image tag to run (latest, X.Y.Z, X.Y, or sha-<short>).
TROVE_TAG=latest

# --- Secrets ---
# Every secret is a plain env var. The stack boots with insecure placeholder
# defaults if these are blank, so CHANGE THEM before real use.
SECRET_KEY=
POSTGRES_PASSWORD=
BOOTSTRAP_HEADHUNTER_PASSWORD=

# --- Optional overrides ---
POSTGRES_USER=trove
POSTGRES_DB=trove
BOOTSTRAP_HEADHUNTER_EMAIL=headhunter@example.com
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_CANDIDATE_REGISTRATION=true
MAX_UPLOAD_MB=10
